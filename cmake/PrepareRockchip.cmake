# MPP 无条件引用 DRM 格式头文件；关闭显示和 GPU 时也必须传入 libdrm 依赖。
set(_file "${SOURCE_DIR}/gst/rockchipmpp/meson.build")
file(READ "${_file}" _content)
set(_old "gstpbutils_dep, mpp_dep, rga_dep]")
set(_new "gstpbutils_dep, mpp_dep, rga_dep, dependency('libdrm', required : true)]")
string(FIND "${_content}" "${_new}" _patched)
if(_patched EQUAL -1)
  string(FIND "${_content}" "${_old}" _position)
  if(_position EQUAL -1)
    message(FATAL_ERROR "Rockchip MPP 依赖列表与预期不符，无法补充 libdrm")
  endif()
  string(REPLACE "${_old}" "${_new}" _content "${_content}")
  file(WRITE "${_file}" "${_content}")
endif()

# 上游格式表已检测 NV16_10LE40，但 AFBC 映射遗漏了同样的条件保护。
set(_file "${SOURCE_DIR}/gst/rockchipmpp/gstmppdec.c")
file(READ "${_file}" _content)
set(_old "    case GST_VIDEO_FORMAT_NV16_10LE40:\n      return DRM_FORMAT_NV20;")
set(_new "#if defined(HAVE_NV16_10LE40) && defined(DRM_FORMAT_NV20)\n${_old}\n#endif")
string(FIND "${_content}" "${_new}" _patched)
if(_patched EQUAL -1)
  string(FIND "${_content}" "${_old}" _position)
  if(_position EQUAL -1)
    message(FATAL_ERROR "Rockchip AFBC 格式映射与预期不符，无法添加兼容保护")
  endif()
  string(REPLACE "${_old}" "${_new}" _content "${_content}")
  file(WRITE "${_file}" "${_content}")
endif()
