#!/bin/sh
# 使用本次构建生成的动态库、插件和扫描器启动应用。
set -eu
pico_build_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
pico_prefix="$pico_build_dir/third_party/prefix"
export LD_LIBRARY_PATH="$pico_prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GST_PLUGIN_PATH_1_0="$pico_prefix/lib/gstreamer-1.0"
export GST_PLUGIN_SYSTEM_PATH_1_0="$pico_prefix/lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER_1_0="$pico_prefix/libexec/gstreamer-1.0/gst-plugin-scanner"
export GST_REGISTRY_1_0="$pico_build_dir/gstreamer-registry.bin"
exec "$pico_build_dir/pico_node" "$@"
